#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>

/ {
	aliases {
		led_red = &rgb_red; 	// This is LED red of the LED RGB 
		led_green = &rgb_green; 	// This is LED green of the LED RGB 
		led_blue = &rgb_blue; 	// This is LED blue of the LED RGB 
	};	
};
&gpioa {
    rgb_red: rgb_red {
        gpios = <&gpioa 5 GPIO_ACTIVE_LOW>;
    };

    rgb_green: rgb_green {
        gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
    };

    rgb_blue: rgb_blue {
        gpios = <&gpioa 7 GPIO_ACTIVE_LOW>;
    };
};