#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led-red = &rgb_red;
		led-green = &rgb_green;
		led-blue = &rgb_blue;
	};

	leds {
		compatible = "gpio-leds";

		rgb_red: red {
			gpios = <&gpioa 5 GPIO_ACTIVE_LOW>;
		};

		rgb_green: green {
			gpios = <&gpioa 6 GPIO_ACTIVE_LOW>;
		};

		rgb_blue: blue {
			gpios = <&gpioa 7 GPIO_ACTIVE_LOW>;
		};
	};
};